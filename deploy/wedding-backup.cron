# Installed to /etc/cron.d/wedding-backup by bootstrap.sh. Times are UTC, after midnight in Astrakhan.
SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

30 3 * * * root /usr/local/sbin/wedding-backup >>/var/log/wedding-backup.log 2>&1
0 4 * * 0 root /usr/local/sbin/wedding-restore-check >>/var/log/wedding-backup.log 2>&1
