{
	# Ports 80 and 443 belong to the VPN on this host. Cloudflare reaches the origin on 2096.
	auto_https disable_redirects
}

wedding.alina-samat.ru:2096 {
	# Cloudflare terminates public TLS in Full mode, so a self-signed origin certificate is enough.
	tls internal

	encode zstd gzip

	header {
		X-Robots-Tag "noindex, nofollow"
		Referrer-Policy "same-origin"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# adapter-node sends no cache headers for static/, so a returning guest refetched every font
	# and photo. Fonts never change; images keep their names when replaced, so they expire sooner.
	header /fonts/* Cache-Control "public, max-age=2592000"
	header /images/* Cache-Control "public, max-age=86400"

	reverse_proxy 127.0.0.1:3000
}
