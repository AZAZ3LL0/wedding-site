[Unit]
Description=Wedding site
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=simple
User=deploy
Group=deploy
WorkingDirectory=/srv/wedding/current
EnvironmentFile=/srv/wedding/shared/.env
Environment=NODE_ENV=production
Environment=HOST=127.0.0.1
Environment=PORT=3000
# Caddy forwards the public scheme and host; adapter-node needs them for CSRF checks on form actions.
Environment=PROTOCOL_HEADER=x-forwarded-proto
Environment=HOST_HEADER=x-forwarded-host
ExecStart=/usr/local/bin/node build/index.js
Restart=on-failure
RestartSec=3

# The host also runs a live VPN: cap memory so the app cannot starve it.
MemoryMax=512M
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
